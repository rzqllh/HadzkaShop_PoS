generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  CASHIER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CASH
  QRIS
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum StockMovementType {
  SALE // Driven by a completed transaction — referenceId = transactionId
  ADD // Manual addition (received shipment, etc.)
  SUBTRACT // Manual subtraction (damage, loss, etc.)
  REFUND // Returned items
}



model Shop {
  id                String   @id @default(uuid())
  name              String
  address           String?
  phone             String?
  taxRate           Decimal  @default(0) @db.Decimal(5, 2)
  currency          String   @default("IDR")
  lowStockThreshold Int      @default(10)
  receiptHeader     String?  @db.Text
  receiptFooter     String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users          User[]
  categories     Category[]
  products       Product[]
  customers      Customer[]
  transactions   Transaction[]
  stockMovements StockMovement[]
}

model User {
  id           String   @id @default(uuid())
  shopId       String
  name         String
  email        String   @unique
  passwordHash String?
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  stockMovements StockMovement[]

  @@index([shopId])
}

model Category {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([shopId])
}

model Product {
  id                String   @id @default(uuid())
  shopId            String
  categoryId        String?
  name              String
  sku               String
  barcode           String?
  price             Decimal  @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  stock             Int      @default(0)
  lowStockThreshold Int?
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactionItems TransactionItem[]
  stockMovements   StockMovement[]

  @@unique([shopId, sku])
}

model Customer {
  id            String        @id @default(uuid())
  shopId        String
  name          String
  phone         String?
  email         String?
  address       String?       @db.Text
  loyaltyPoints Int           @default(0)
  totalSpent    Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([shopId])
  @@index([shopId, name])
}

model Transaction {
  id                    String            @id @default(uuid())
  shopId                String
  cashierId             String
  customerId            String?
  transactionNumber     String            @unique
  status                TransactionStatus @default(PENDING)
  paymentMethod         PaymentMethod
  subtotal              Decimal           @db.Decimal(12, 2)
  discountAmount        Decimal           @default(0) @db.Decimal(12, 2)
  taxRate               Decimal           @default(0) @db.Decimal(5, 2)
  taxAmount             Decimal           @default(0) @db.Decimal(12, 2)
  shippingCost          Decimal           @default(0) @db.Decimal(12, 2)
  total                 Decimal           @db.Decimal(12, 2)
  amountPaid            Decimal           @db.Decimal(12, 2)
  changeDue             Decimal           @default(0) @db.Decimal(12, 2)
  note                  String?           @db.Text
  midtransOrderId       String?
  midtransTransactionId String?
  midtransStatus        String?
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashier        User              @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          TransactionItem[]
  stockMovements StockMovement[]

  @@index([shopId])
  @@index([shopId, createdAt])
}

model TransactionItem {
  id            String   @id @default(uuid())
  transactionId String
  productId     String
  productName   String // snapshot at time of sale
  unitPrice     Decimal  @db.Decimal(12, 2) // snapshot at time of sale
  costPrice     Decimal? @db.Decimal(12, 2) // snapshot at time of sale for accurate PnL
  quantity      Int
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transactionId])
}

model StockMovement {
  id            String            @id @default(uuid())
  shopId        String
  productId     String
  userId        String // cashier (SALE) or staff (ADD/SUBTRACT)
  type          StockMovementType
  quantity      Int
  reason        String // auto-filled "Sale #TXN-xxx" for SALE type
  referenceId   String? // transactionId when type = SALE, null for manual
  previousStock Int
  newStock      Int
  createdAt     DateTime          @default(now())

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([productId])
}

