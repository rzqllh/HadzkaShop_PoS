generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  CASHIER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum StockAdjustmentType {
  ADD
  SUBTRACT
}

enum TillStatus {
  OPEN
  CLOSED
}

model Shop {
  id                String   @id @default(uuid())
  name              String
  address           String?
  phone             String?
  taxRate           Decimal  @default(0) @db.Decimal(5, 2)
  currency          String   @default("IDR")
  lowStockThreshold Int      @default(10)
  receiptHeader     String?  @db.Text
  receiptFooter     String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users             User[]
  categories        Category[]
  products          Product[]
  transactions      Transaction[]
  stockAdjustments  StockAdjustment[]
  tillSessions      TillSession[]
}

model User {
  id           String   @id @default(uuid())
  shopId       String
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  stockAdjustments StockAdjustment[]
  tillSessions     TillSession[]
}

model Category {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]
}

model Product {
  id                String   @id @default(uuid())
  shopId            String
  categoryId        String?
  name              String
  sku               String
  barcode           String?
  price             Decimal  @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  stock             Int      @default(0)
  lowStockThreshold Int?
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactionItems TransactionItem[]
  stockAdjustments StockAdjustment[]

  @@unique([shopId, sku])
}

model Transaction {
  id                    String            @id @default(uuid())
  shopId                String
  cashierId             String
  transactionNumber     String            @unique
  status                TransactionStatus @default(PENDING)
  paymentMethod         PaymentMethod
  subtotal              Decimal           @db.Decimal(12, 2)
  discountAmount        Decimal           @default(0) @db.Decimal(12, 2)
  taxRate               Decimal           @default(0) @db.Decimal(5, 2)
  taxAmount             Decimal           @default(0) @db.Decimal(12, 2)
  shippingCost          Decimal           @default(0) @db.Decimal(12, 2)
  total                 Decimal           @db.Decimal(12, 2)
  amountPaid            Decimal           @db.Decimal(12, 2)
  changeDue             Decimal           @default(0) @db.Decimal(12, 2)
  note                  String?           @db.Text
  midtransOrderId       String?
  midtransTransactionId String?
  midtransStatus        String?
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  shop         Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashier      User              @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items        TransactionItem[]
}

model TransactionItem {
  id            String   @id @default(uuid())
  transactionId String
  productId     String
  productName   String   // snapshot at time of sale
  unitPrice     Decimal  @db.Decimal(12, 2) // snapshot at time of sale
  quantity      Int
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model StockAdjustment {
  id            String              @id @default(uuid())
  shopId        String
  productId     String
  userId        String
  type          StockAdjustmentType
  quantity      Int
  reason        String
  previousStock Int
  newStock      Int
  createdAt     DateTime            @default(now())

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model TillSession {
  id           String     @id @default(uuid())
  shopId       String
  cashierId    String
  openedAt     DateTime   @default(now())
  closedAt     DateTime?
  startingCash Decimal    @db.Decimal(12, 2)
  expectedCash Decimal?   @db.Decimal(12, 2)
  actualCash   Decimal?   @db.Decimal(12, 2)
  difference   Decimal?   @db.Decimal(12, 2)
  notes        String?    @db.Text
  status       TillStatus @default(OPEN)

  shop    Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashier User @relation(fields: [cashierId], references: [id], onDelete: Restrict)
}
